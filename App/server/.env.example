# Railway injects DATABASE_URL automatically once you attach a Postgres
# plugin to this service — you don't need to set it by hand in production.
# For local/TRAE IDE use, point this at a local Postgres or a Railway
# instance's public connection string (see README for how to get one).
DATABASE_URL=postgresql://user:password@localhost:5432/verta

# Railway injects PORT automatically too; this is just for local dev.
PORT=3000

# Required. Any long random string — used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional — the admin area uses ONE shared password (like the original
# app). Leave these unset and it defaults to:
#   email:    admin@vertadelivery.com
#   password: 1Nigeria@
# Override here (or in Railway's Variables tab) if you want a different
# password. The admin account is created automatically on first boot.
ADMIN_EMAIL=admin@vertadelivery.com
ADMIN_PASSWORD=1Nigeria@

# --- Verta's own delivery_company account ("Verta Delivery Service") ---
# Uses its own distinct email, separate from Manage Agent's — created
# automatically on next restart, no manual steps required first.
VERTA_DC_EMAIL=verta.dc@vertadelivery.com
VERTA_DC_PASSWORD=1Nigeria@

# Required to confirm deleting an order or an expense. Defaults to "SKY"
# if unset, matching the original app.
DELETE_PASSWORD=SKY

# --- WhatsApp/SMS order notifications (Twilio) ---
# All optional — leave blank and notifications are simply skipped.
# See README.md -> "Setting up WhatsApp/SMS notifications" for full steps.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NOTIFY_TO_NUMBER=+231881405696
NOTIFY_CHANNEL=whatsapp

# --- Email notifications (generic SMTP) ---
# Optional — leave blank and email notifications are simply skipped,
# same as the SMS/WhatsApp section above. Works with Gmail, a custom
# business domain, or a dedicated transactional service (SendGrid,
# Resend, etc.) — anything that speaks SMTP.
#
# Easiest path if you already use Gmail (e.g. onlib231@gmail.com):
#   1. Go to https://myaccount.google.com/apppasswords
#      (requires 2-Step Verification to be turned on for that account)
#   2. Create an "App Password" for this app — Google gives you a
#      16-character code. This is NOT your normal Gmail password.
#   3. SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
#   4. SMTP_USER=your full Gmail address
#   5. SMTP_PASS=the 16-character App Password from step 2
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
NOTIFY_EMAIL_TO=onlib231@gmail.com

# --- Sign in with Google ---
# Optional — leave blank and the Google Sign-In button on the login
# screen simply stays disabled, exactly as it does today. Set this to
# turn it on:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create a project (or use an existing one)
#   3. Create Credentials -> OAuth client ID -> Application type: Web application
#   4. Under "Authorized JavaScript origins", add your real deployed
#      URL (e.g. https://verta-delivery-production.up.railway.app)
#   5. Copy the Client ID it gives you (looks like
#      123456789-abc...xyz.apps.googleusercontent.com) and paste it below
# No client secret is needed for this — the frontend flow used here
# (Google Identity Services) only requires the Client ID, and the
# server verifies the token's signature using Google's own public keys.
GOOGLE_CLIENT_ID=
